---
import Layout from '@/layouts/Layout.astro';

import About from '@/components/home/sections/About.astro';
import Projects from '@/components/home/sections/Projects.astro';
import Experiences from '@/components/home/sections/Experiences.astro';
// import Posts from '@/components/home/sections/Posts.astro';

import { SECTIONS } from '@/constants/sections';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alejandro Porras',
  description = 'Alejandro Porras Personal Website. Software Engineer from Madrid, Spain.'
} = Astro.props;
---

<Layout title={title} description={description}>
  <About section={SECTIONS.about} />

  <Projects section={SECTIONS.projects} />

  <Experiences section={SECTIONS.experiences} />

  <!-- <Posts section={SECTIONS.posts} /> -->
</Layout>
