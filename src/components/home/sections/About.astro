---
import { MailIcon, MailOpenIcon } from 'lucide-vue-next';

import { useTranslations } from '@/i18n/utils';

import Section from '@/components/common/Section.astro';
import Link from '@/components/common/Link.astro';
import { Button } from '@/components/ui/button';

import { SECTIONS } from '@/constants/sections';

const t = useTranslations(Astro.currentLocale);
---

<Section id={SECTIONS.about.label}>
  <div class="mb-3">
    <h1 class="inline md:block">
      {t.about.info.title.introduction}
      <span class="font-semibold">{t.about.info.title.profession}</span>
      {t.about.info.title.location}
    </h1>

    <h2 class="inline md:block">
      {t.about.info.subtitle}
    </h2>
  </div>

  <Link
    id="contact-button"
    href="mailto:hello@skuzow.com"
    title={t.about.buttons.contact.description}
    newTab={false}
    underline={false}
  >
    <Button class="gap-2 font-mono">
      <MailIcon id="mail-icon" size={16} />
      <MailOpenIcon id="mail-open-icon" size={16} class="hidden" />
      {t.about.buttons.contact.title}
    </Button>
  </Link>
</Section>

<script>
  document.addEventListener('astro:page-load', () => {
    const contactButton = document.getElementById('contact-button');

    const mailIcon = document.getElementById('mail-icon');
    const mailOpenIcon = document.getElementById('mail-open-icon');

    contactButton?.addEventListener('mouseover', () => {
      mailIcon?.classList.add('hidden');
      mailOpenIcon?.classList.remove('hidden');
    });

    contactButton?.addEventListener('mouseout', () => {
      mailOpenIcon?.classList.add('hidden');
      mailIcon?.classList.remove('hidden');
    });
  });
</script>
