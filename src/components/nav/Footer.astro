---
import { useTranslations } from '@/i18n/utils';

import Link from '@/components/common/Link.astro';

const t = useTranslations(Astro.currentLocale);

const currentYear = String(new Date().getFullYear());
---

<footer class="py-4">
  <nav
    class="mx-auto flex w-full max-w-4xl flex-1 flex-col items-center justify-between px-8 font-mono font-medium md:flex-row"
  >
    <p>
      🎲
      <br class="hidden md:flex" />
      {t.footer.title}
    </p>

    <div class="flex items-end gap-2 md:flex-col md:gap-0">
      <Link
        href="mailto:hello@skuzow.com"
        title={t.about.buttons.contact.description}
        newTab={false}
      >
        {t.about.buttons.contact.title}
      </Link>

      <div class="flex gap-1">
        <h2>Alejandro Porras</h2>
        <span>·</span>
        <time datetime={currentYear}>{currentYear}</time>
      </div>
    </div>
  </nav>
</footer>
