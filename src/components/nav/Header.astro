---
import { LinkedinIcon, GithubIcon } from 'lucide-vue-next';

import { useLocaleUrl } from '@/i18n/utils';
import { defaultLang } from '@/i18n/ui';

import Link from '@/components/common/Link.astro';
import LogoIcon from '@/components/icons/LogoIcon.astro';
import { Button } from '@/components/ui/button';
import LangToggle from '@/components/nav/LangToggle.vue';
import ThemeToggle from '@/components/nav/ThemeToggle.vue';

const lang: string = Astro.currentLocale || defaultLang;

const url = useLocaleUrl(Astro.currentLocale);
---

<header class="bg-background/80 sticky top-0 z-10 py-4 backdrop-blur-md">
  <nav class="mx-auto flex w-full max-w-4xl flex-1 justify-between px-8">
    <Link
      id="home-link"
      href={url('/')}
      title="Home"
      newTab={false}
      class="flex items-center gap-2.5"
    >
      <LogoIcon size={30} />
      <span class="font-mono font-medium">skuzow.com</span>
    </Link>

    <div class="flex items-center gap-1">
      <Link
        href="https://www.linkedin.com/in/alejandro-porras-torrecilla"
        title="LinkedIn"
        underline={false}
      >
        <Button variant="ghost" size="icon">
          <LinkedinIcon size={18} />
          <span class="sr-only">Linkedin</span>
        </Button>
      </Link>

      <Link href="https://github.com/skuzow" title="Github" underline={false}>
        <Button variant="ghost" size="icon">
          <GithubIcon size={18} />
          <span class="sr-only">Github</span>
        </Button>
      </Link>

      <LangToggle
        client:load
        currentLang={lang}
        currentPath={Astro.url.pathname}
      />

      <ThemeToggle client:load />
    </div>
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const homeLink = document.getElementById('home-link');

    homeLink?.addEventListener('click', (event) => {
      const isHomePage: boolean = window.location.pathname === '/';
      if (!isHomePage) return;

      event.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  });
</script>
